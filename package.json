{
  "name": "@provokke/catalogue-sync-pipeline",
  "version": "0.3.0",
  "description": "Sync product catalogues from suppliers into Shopify with diffing, checkpoints and pluggable adapters",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Provokke/catalogue-sync-pipeline.git"
  },
  "author": "Provokke",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "demo": "npm run build && node dist/demo/main.js",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "shopify",
    "catalogue",
    "sync",
    "pipeline",
    "etl",
    "suppliers"
  ]
}
